{
  "name": "@outrank/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma": "dotenv -e ../../.env -- prisma",
    "db:migrate:diff": "dotenv -e ../../.env -- prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url %DATABASE_URL_TEST% --script",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "node scripts/import-questions.mjs",
    "smoke": "node scripts/smoke.mjs",
    "questions:import": "node scripts/import-questions.mjs"
  },
  "dependencies": {
    "@nestjs/common": "~11.1.6",
    "@nestjs/core": "~11.1.6",
    "@nestjs/platform-express": "~11.1.6",
    "@nestjs/platform-socket.io": "~11.1.6",
    "@nestjs/websockets": "~11.1.6",
    "@outrank/shared": "0.1.0",
    "@prisma/client": "~6.16.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "~11.0.10",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "dotenv-cli": "^10.0.0",
    "prisma": "~6.16.2",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3"
  }
}
