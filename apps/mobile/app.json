{
  "expo": {
    "name": "Outrank",
    "slug": "outrank",
    "scheme": "outrank",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F3FF",
    "ios": {
      "bundleIdentifier": "com.outrank.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "The camera is used only to scan a game's QR code so you can join it."
      }
    },
    "android": {
      "package": "com.outrank.app",
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "themeColor": "#6C3BFF",
      "backgroundColor": "#F5F3FF"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used only to scan a game's QR code so you can join it.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "supportsRTL": true
    }
  }
}
