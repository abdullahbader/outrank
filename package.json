{
  "name": "outrank",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @outrank/shared && npm run build -w @outrank/api",
    "test": "npm run test -w @outrank/shared",
    "typecheck": "npm run typecheck -w @outrank/shared && npm run typecheck -w @outrank/api",
    "db:start": "powershell -ExecutionPolicy Bypass -File scripts/db.ps1 start",
    "db:stop": "powershell -ExecutionPolicy Bypass -File scripts/db.ps1 stop",
    "db:deploy": "npm run db:deploy -w @outrank/api",
    "api:dev": "npm run dev -w @outrank/api",
    "smoke": "npm run build && npm run smoke -w @outrank/api",
    "questions:check": "node content/validate.mjs",
    "questions:import": "npm run questions:import -w @outrank/api --",
    "app:web": "npm run web -w @outrank/mobile",
    "app:start": "npm run start -w @outrank/mobile",
    "postinstall": "npm run build -w @outrank/shared"
  },
  "engines": {
    "node": ">=24"
  }
}
